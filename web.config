<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- O módulo WebDAV do IIS intercepta PUT/DELETE e devolve 405; a API precisa desses verbos. -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Publicação self-contained (win-x64): o .NET vai junto, o servidor só precisa do módulo AspNetCoreModuleV2. -->
      <aspNetCore processPath=".\NewsPortal.Api.exe" arguments="" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- Uploads de até 10 MB (o controller valida de novo); o padrão do IIS é 30 MB. -->
          <requestLimits maxAllowedContentLength="12582912" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
